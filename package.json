{
  "name": "personal-website",
  "version": "1.0.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "reference": "node scripts/reference.mjs",
    "preview": "node scripts/serve.mjs _site 4000",
    "test": "node --test tests/*.test.mjs",
    "test:visual": "playwright test",
    "test:aa": "AA=1 playwright test",
    "check": "npm run format:check && node scripts/check.mjs",
    "dev": "node scripts/dev.mjs",
    "test:performance": "node scripts/performance.mjs",
    "test:all": "npm run reference && npm run build && npm test && npm run check && npm run test:aa && npm run test:visual && npm run test:performance",
    "test:container": "node scripts/container.mjs",
    "format": "prettier --write \"scripts/**/*.mjs\" \"tests/*.mjs\" playwright.config.mjs package.json scripts/lib/publication-meta.json",
    "format:check": "prettier --check \"scripts/**/*.mjs\" \"tests/*.mjs\" playwright.config.mjs package.json scripts/lib/publication-meta.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xingjian-zhang/xingjian-zhang.github.io.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/xingjian-zhang/xingjian-zhang.github.io/issues"
  },
  "homepage": "https://github.com/xingjian-zhang/xingjian-zhang.github.io#readme",
  "description": "",
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "pngjs": "7.0.0",
    "prettier": "3.6.2"
  },
  "prettier": {
    "singleQuote": true
  }
}
